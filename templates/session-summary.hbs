<div class="world-name-display-card session-summary-card">
    {{#if showLogo}}
    <div class="card-logo">
        <img src="{{logoPath}}" alt="Campaign Logo"/>
    </div>
    {{/if}}
    <header class="card-header">
        <div class="header-titles">
            {{#if showWorldName}}
            <h3>{{worldName}}</h3>
            {{/if}}
            <h4><strong>{{campaignName}} - Session Summary</strong></h4>
        </div>
    </header>
    <div class="card-content">
        <p class="session-info"><strong>Session #{{sessionNumber}}</strong></p>
        <div class="summary-stats">
            <div class="stat-item">
                <i class="fas fa-swords"></i>
                <span><strong>{{combats}}</strong> Combats Resolved</span>
            </div>
            <div class="stat-item">
                <i class="fas fa-skull"></i>
                <span><strong>{{enemiesDefeated}}</strong> Enemies Defeated</span>
            </div>
        </div>

        {{#if encounterHistory.length}}
        <div class="encounter-log">
            <p class="log-title"><strong>Encounter Log:</strong></p>
            {{#each encounterHistory}}
            <div class="encounter-entry">
                <span class="encounter-num">Encounter #{{this.encounterNumber}}:</span>
                <span class="defeated-list">
                    {{#if this.monsters.length}}
                        {{#each this.monsters}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                    {{else}}
                        <em>None</em>
                    {{/if}}
                </span>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </div>
</div>
