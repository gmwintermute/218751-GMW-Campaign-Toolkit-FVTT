<div class="turn-marker {{type}} {{#if isDefeated}}defeated{{/if}}" data-actor-id="{{actorId}}">
    {{#if isDefeated}}
    <div class="defeated-status-bar">
        <i class="fa-solid fa-skull"></i>
    </div>
    {{/if}}

    <div class="header-line">
        {{#if tokenImg}}
        <img src="{{tokenImg}}" class="token-image" />
        {{/if}}
        <h3>{{{message}}}{{#if isDefeated}} (Defeated){{/if}}</h3>
    </div>

    <div class="status-block">
        {{#if hp}}
        <div class="hp-info">
            <span class="hp-label">{{localize "TRACKER_NOTES.HP"}}:</span>
            <span class="hp-values">
                <span class="hp-current" title="{{localize "TRACKER_NOTES.CurrentHP"}}">{{hp.value}}</span> / 
                <span class="hp-max" title="{{localize "TRACKER_NOTES.MaxHP"}}">{{hp.max}}</span>
                {{#if hp.temp}}
                <span class="hp-temp" title="{{localize "TRACKER_NOTES.TempHP"}}">(+{{hp.temp}})</span>
                {{/if}}
            </span>
        </div>
        {{/if}}

        {{#if ac}}
        <div class="ac-info">
            <span class="ac-label">{{localize "TRACKER_NOTES.AC"}}:</span>
            <span class="ac-value">{{ac}}</span>
        </div>
        {{/if}}

        {{#if speed}}
        <div class="speed-info">
            <span class="speed-label">{{localize "TRACKER_NOTES.Speed"}}:</span>
            <span class="speed-value">{{speed}}</span>
        </div>
        {{/if}}

        {{#if (ne spellDC null)}}
        <div class="spelldc-info">
            <span class="spelldc-label">{{localize "TRACKER_NOTES.SpellDC"}}:</span>
            <span class="spelldc-value">{{spellDC}}</span>
        </div>
        {{/if}}

        {{#if inspiration}}
        <div class="inspiration-info">
            <span class="inspiration-label">{{localize "TRACKER_NOTES.Inspiration"}}:</span>
            <span class="inspiration-value">
                <i class="fa-solid fa-sun"></i>
                <i class="fa-solid fa-bolt use-inspiration-btn" data-actor-id="{{actorId}}" title="Use Inspiration"></i>
            </span>
        </div>
        {{/if}}

        {{#if deathSaves}}
        <div class="death-saves">
            <span class="ds-label">{{localize "TRACKER_NOTES.DeathSaves"}}:</span>
            <span class="ds-successes" title="{{localize "TRACKER_NOTES.DeathSavesSuccess"}}">
                <i class="fa-solid fa-check"></i> {{deathSaves.success}}
            </span>
            <span class="ds-failures" title="{{localize "TRACKER_NOTES.DeathSavesFailure"}}">
                <i class="fa-solid fa-xmark"></i> {{deathSaves.failure}}
            </span>
        </div>
        {{/if}}
    </div>

    {{#if effects.length}}
    <div class="effects-list">
        {{#each effects}}
        <div class="effect-item" title="{{this.name}}" data-actor-id="{{../actorId}}" data-effect-id="{{this.id}}">
            {{#if this.icon}}
            <img src="{{this.icon}}" class="effect-icon" />
            {{/if}}
            <span class="effect-name">{{this.name}}</span>
            {{#if (eq ../type "end-turn")}}
            <a class="delete-effect-chat" title="Remove Effect" style="cursor: pointer; margin-left: 4px; color: #888;">
                <i class="fa-solid fa-xmark"></i>
            </a>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

</div>