<form class="flexcol gm-tracker-config">
    <div class="form-group">
        <label>Show World Name</label>
        <div class="form-fields">
            <input type="checkbox" name="showWorldName" {{checked showWorldName}}>
        </div>
        <p class="notes">Toggle whether the world name is displayed in the chat card.</p>
    </div>
    <div class="form-group">
        <label>Show Logo</label>
        <div class="form-fields">
            <input type="checkbox" name="showLogo" {{checked showLogo}}>
        </div>
        <p class="notes">Toggle whether the logo is displayed in the chat card.</p>
    </div>
    <div class="form-group">
        <label>{{localize "Campaign Name"}}</label>
        <div class="form-fields">
            <input type="text" name="campaignName" value="{{campaignName}}">
        </div>
        <p class="notes">The name of the campaign to display.</p>
    </div>
    <div class="form-group">
        <label>Logo Image</label>
        <div class="form-fields">
            <input type="text" name="logoPath" value="{{logoPath}}">
            <button type="button" class="file-picker" data-type="image" data-target="logoPath" title="Browse Files">
                <i class="fas fa-file-import"></i>
            </button>
        </div>
        <p class="notes">The logo image to display in the chat card.</p>
    </div>
    <div class="form-group">
        <label>{{localize "Session Number"}}</label>
        <div class="form-fields">
            <button type="button" class="session-control" data-action="minus" title="Decrease Session Number">
                <i class="fas fa-minus"></i>
            </button>
            <input type="number" name="sessionNumber" value="{{sessionNumber}}" step="1">
            <button type="button" class="session-control" data-action="plus" title="Increase Session Number">
                <i class="fas fa-plus"></i>
            </button>
        </div>
        <p class="notes">The current session number.</p>
    </div>
    <footer class="sheet-footer flexcol" style="gap: 5px;">
        <button type="submit" name="submit">
            <i class="fas fa-save"></i> {{localize "Save Changes"}}
        </button>
        <div class="flexrow" style="gap: 5px;">
            <button type="button" class="post-summary">
                <i class="fas fa-file-alt"></i> Session Summary
            </button>
            <button type="button" class="post-encounter-log">
                <i class="fas fa-list-ol"></i> Encounter Log
            </button>
        </div>
        <button type="button" class="reset-stats" style="background: rgba(150, 0, 0, 0.5); color: white; border: 1px solid #7a7971;">
            <i class="fas fa-trash"></i> Reset Combat Stats & Log
        </button>
    </footer>
</form>